    {
      "parameters": {
        "jsCode": "const appt = $('Get Appointment').first().json;\nconst f = appt.fields || {};\nconst NL = String.fromCharCode(10);\n\n// The language is not known on this branch, so the message is sent in both languages\nconst en = 'We received your payment but your time slot was released. Our team will contact you shortly to fix this.';\nconst es = 'Recibimos su pago, pero su horario fue liberado. Nuestro equipo se comunicará con usted pronto para resolverlo.';\n\nconst reply_text = en + NL + NL + es;\n\nconst alert_text = 'LATE PAYMENT: ' + (f.name || 'a customer') + ' (' + (f.phone || 'no phone') + ') paid the deposit after the hold expired. Appointment record: ' + appt.id + '. Please contact them and fix the booking.';\n\nreturn [{ json: {\n  phone: f.phone,\n  reply_text,\n  alert_text,\n  appt_record_id: appt.id\n}}];"
      },
