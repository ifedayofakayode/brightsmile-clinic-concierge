    {
      "parameters": {
        "jsCode": "const appt = $('Get Appointment').first().json.fields || {};\nconst conv = $('Reset Conversation').first().json.fields || {};\nconst L = conv.language === 'es' ? 'es' : 'en';\nconst when = DateTime.fromISO(appt.start_iso).setZone('America/Chicago').setLocale(L).toFormat('cccc d LLLL, h:mm a');\nconst text = L === 'es'\n  ? '¡Su cita está confirmada para el ' + when + ' (hora del Centro)! Esperamos verle pronto. Responda HUMANO si necesita algo.'\n  : 'Your appointment is confirmed for ' + when + ' (Central Time)! We look forward to seeing you. Reply HUMAN if you need anything.';\nreturn [{ json: { phone: appt.phone, reply_text: text } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        -96
      ],
      "id": "63bd8d67-fb81-42dc-af36-1ab700e001aa",
      "name": "Build Confirmation"
